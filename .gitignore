# exiftool в репозитории не хранится: tools/fetch_exiftool.ps1 скачивает закреплённую версию
# и сверяет каждый файл с tools/exiftool.sha256; внутрь exe он попадает через OriginEcho.spec
tools/exiftool/

# рабочие файлы программы
tools/errors.log
tools/lang.cfg
tools/__pycache__/
__pycache__/
*.pyc

# сборка PyInstaller (но скрипт иконки коммитим)
build/*
!build/make_icon.py
dist/

# ОС и редакторы
.DS_Store
Thumbs.db
.vscode/
.idea/
